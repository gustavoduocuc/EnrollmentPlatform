# Copia a .env y completa con tus valores. NO commitear .env.
# Cada fork configura sus secrets en GitHub Actions (ver docs/guia-despliegue-ec2.md).

# Perfil activo: local (H2) | prod (Oracle)
SPRING_PROFILES_ACTIVE=local

# Solo perfil prod — Oracle Cloud Autonomous (mTLS vía wallet)
# 1. Descarga tu Instance Wallet desde OCI y colócala en Wallet_ENROLLMENTPLATFORMDB/
#    (ver wallet.example/README.md)
# 2. Lista los alias de TU tnsnames.ora: grep '^[a-z]' Wallet_ENROLLMENTPLATFORMDB/tnsnames.ora
# 3. Usa uno de esos alias en SPRING_DATASOURCE_URL (no copies el de otro desarrollador)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<tu_alias_tns>_high
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Ruta a la wallet (opcional; por defecto ./Wallet_ENROLLMENTPLATFORMDB)
# ORACLE_WALLET_DIR=/ruta/absoluta/a/tu/wallet

SERVER_PORT=8080

# AWS S3 — resúmenes de inscripción (perfil local: LocalStack en localhost:4566)
AWS_REGION=us-east-1
AWS_S3_BUCKET=enrollment-platform-summaries
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Solo perfil prod — seguridad JWT Azure AD (requerido en producción; desactivar solo para pruebas locales)
# ENROLLMENT_SECURITY_JWT_ENABLED=true
# AZURE_B2C_JWK_SET_URI=https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>/discovery/v2.0/keys
# AZURE_B2C_AUDIENCE=<client-id-de-tu-app-en-azure>
# ENROLLMENT_SECURITY_LOG_LEVEL=INFO
