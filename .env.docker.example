# Copia a .env en EC2 o local Docker. NO commitear .env.
# Cada fork configura sus secrets en GitHub Actions (ver docs/guia-despliegue-ec2.md).

SPRING_PROFILES_ACTIVE=prod

# Oracle — usa el alias de TU tnsnames.ora (grep '^[a-z]' en tu wallet)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<tu_alias_tns>_high
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# En contenedor Docker la wallet se monta en /app/wallet (docker-compose) o se copia en build (CI)
ORACLE_WALLET_DIR=/app/wallet

SERVER_PORT=8080

# AWS S3 — producción (sin AWS_S3_ENDPOINT; el SDK usa el endpoint regional)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seguridad JWT Azure AD (requerido en producción; valores de TU tenant/fork)
ENROLLMENT_SECURITY_JWT_ENABLED=true
AZURE_B2C_JWK_SET_URI=https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>/discovery/v2.0/keys
AZURE_B2C_AUDIENCE=<client-id-de-tu-app-en-azure>
# ENROLLMENT_SECURITY_LOG_LEVEL=INFO

# Opcional si usas imagen de Docker Hub en lugar de build local:
# DOCKERHUB_USERNAME=tu_usuario
